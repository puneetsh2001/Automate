# Copy to .env and adjust.  (copy .env.example .env)

# --- Database -----------------------------------------------------------
# PostgreSQL (recommended):
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/electricity_bills
# MySQL (pip install pymysql first):
# DATABASE_URL=mysql+pymysql://root:CHANGE_ME@localhost:3306/electricity_bills
# SQLite (zero setup, good for a quick local try):
# DATABASE_URL=sqlite:///./electricity_bills.db

# --- Uploads ------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# --- OCR ----------------------------------------------------------------
# Leave empty to auto-detect (PATH, then C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
# Tesseract language(s), e.g. eng or eng+hin (language data must be installed)
OCR_LANGUAGE=eng
# Page segmentation mode (3 = automatic layout)
OCR_PSM=3
# auto = try light and binarized preprocessing and keep the better result | light | binary | none
OCR_PREPROCESS_MODE=auto
OCR_TIMEOUT_SECONDS=120
# Mean OCR confidence below this adds a warning
OCR_LOW_CONFIDENCE_THRESHOLD=60

# --- PDF ----------------------------------------------------------------
PDF_RENDER_DPI=300
# A PDF page needs at least this many text characters to skip OCR
PDF_TEXT_MIN_CHARS=50
PDF_MAX_PAGES=20

# --- Validation / parsing -------------------------------------------------
# Allowed |(current - previous) - units| before a mismatch warning
METER_READING_TOLERANCE=1.0
# Optional JSON with extra label aliases, e.g. {"due_date": ["Pay Till"]}
LABEL_ALIASES_FILE=

# --- App ----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
